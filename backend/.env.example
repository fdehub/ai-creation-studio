# ==========================================
# AI 小说智能创作平台 - 后端环境变量配置
# ==========================================

# 1. 大语言模型配置 (LLM Configuration)
# 如果您使用的是 OpenAI 官方服务，只需填写 OPENAI_API_KEY。
# 如果您使用的是国内模型（如 DeepSeek, 智谱, 阿里千问等兼容 OpenAI 接口的模型）或代理，请填写 OPENAI_BASE_URL 和对应的 KEY。

OPENAI_API_KEY=""

# 如果使用第三方兼容接口，取消下面这行的注释并修改为实际的 Base URL
# OPENAI_BASE_URL="https://api.deepseek.com/v1"

# 填入您想使用的具体模型名称 (例如 gpt-4o, deepseek-chat, qwen-max 等)
# 不填则默认为 gpt-4-turbo-preview
# LLM_MODEL_NAME="deepseek-chat"

# Optional overrides used by historical local scripts. Never put real values in source.
# EDITOR_API_KEY=""
# EDITOR_BASE_URL="https://api.openai.com/v1"
# EDITOR_MODEL="your-model-name"

# 当前检索使用 SQLite FTS，无需配置 Elasticsearch。
