# Optional runtime settings. Copy to runtime.env and edit; do not overwrite .env.
# Local defaults work without this file. Set a random token for remote deployment.
# NOVEL_ACCESS_TOKEN=
# NOVEL_DATA_DIR=D:/novel-data
# NOVEL_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# NOVEL_ALLOWED_ORIGINS=http://localhost:5273,http://127.0.0.1:5273
# NOVEL_PROVIDER_HOSTS=api.openai.com
# Explicit opt-in only for a trusted local model service:
# NOVEL_LOCAL_PROVIDER_HOSTS=localhost,127.0.0.1
